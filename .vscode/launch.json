{
  // Run/Debug configurations for the Flutter app.
  //
  // "Library App (emulator/simulator)" needs no extra config — Android
  // emulators and iOS simulators reach the local backend automatically
  // (see lib/core/network/api_config.dart).
  //
  // "Library App (physical device)" targets a phone on the same Wi-Fi
  // network as this machine. Replace REPLACE_WITH_YOUR_LAN_IP below with
  // your machine's LAN IP (run `ipconfig getifaddr en0` on macOS, or use
  // `./scripts/run.sh` from a terminal instead, which detects it for you
  // automatically on every run).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Library App (emulator/simulator)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      "name": "Library App (physical device)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define=API_BASE_URL=http://REPLACE_WITH_YOUR_LAN_IP:3000"
      ]
    }
  ]
}
